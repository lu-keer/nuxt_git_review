log=$(git rev-parse --git-path hook-checks.log)
printf '%s pre-push started\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$log"
printf '[git-hook] pre-push: starting checks\n'
if yarn check; then
  result=0
else
  result=$?
fi
printf '%s pre-push exit=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$result" >> "$log"
exit "$result"
